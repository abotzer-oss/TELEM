#!/bin/sh
# ==========================================================================
# telemenv.co.il — pre-commit
#
# שתי משימות, ושתיהן נובעות מתקלות אמיתיות שקרו באתר:
#
#   1. חסימת לידים ריקים. ב-26.9.2026 הגיע ליד עם כל שדות המעקב מלאים
#      וכל שדות הגולש ריקים, כי הטפסים נשאו novalidate וה-JS לא קרא
#      ל-checkValidity(). הבדיקה חוסמת קומיט ששובר טופס.
#
#   2. sitemap.xml מסונכרן. עד 28.9.2026 כל 29 הערכים בסייטמאפ נשאו
#      lastmod ישן — 14 מהם טענו למרץ אף שהעמודים עודכנו בספטמבר.
#      הסייטמאפ נגזר מה-canonical של כל עמוד ונבנה מחדש אוטומטית.
#
# התקנה (פעם אחת):  git config core.hooksPath tools/hooks
# דילוג חד-פעמי:     git commit --no-verify
# ==========================================================================

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

# בוחרים מפרש ע"י *הרצה* ולא ע"י command -v: ב-Windows הפקודה python3
# מוצאת stub של Microsoft Store שנמצא ב-PATH אבל נכשל בהרצה בפועל.
PY=""
for c in python python3 py; do
  if "$c" -c "import sys" >/dev/null 2>&1; then
    PY="$c"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "pre-commit: לא נמצא מפרש python שרץ בפועל — הבדיקות לא רצו." >&2
  exit 0
fi

# --- 1. טפסי לידים (חוסם) ---
if [ -f tools/check_lead_guard.py ]; then
  "$PY" tools/check_lead_guard.py || {
    echo "" >&2
    echo "ה-commit נעצר: טופס לידים באתר אינו מוגן." >&2
    echo "תקן את מה שמופיע למעלה, או הרץ git commit --no-verify אם אתה בטוח." >&2
    exit 1
  }
fi

# --- 2. sitemap.xml (בונה מחדש ומוסיף לקומיט) ---
if [ -f tools/build_sitemap.py ] &&
   git diff --cached --name-only --diff-filter=ACMRD | grep -qE '\.html$'; then
  "$PY" tools/build_sitemap.py >/dev/null || {
    echo "pre-commit: בניית sitemap.xml נכשלה." >&2
    exit 1
  }
  git add sitemap.xml
fi

exit 0
